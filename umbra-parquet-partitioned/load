#!/bin/bash
set -eu

source ../local-env.sh

# No ingestion: define the view over data/hits.parquet (fetched by ./install).
# create.sql reads the container's /data bind mount, create_local.sql the
# host-relative data/hits.parquet. The view lives in the db, so it survives
# the driver's per-query restarts and ./load runs once.
CREATE_FILE=create.sql
[ "$LOCAL" -eq 1 ] && CREATE_FILE=create_local.sql
chmod -R 777 data
PGPASSWORD=postgres psql -p 5432 -h 127.0.0.1 -U postgres -v ON_ERROR_STOP=1 \
    -c 'DROP VIEW IF EXISTS hits;' -f "$CREATE_FILE"

sync
